# Copy to .env on the production server and fill in real values.
# Local development needs none of this — config.settings.dev has working defaults.

# Selects the settings module. Production must use config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# Comma-separated hostnames the site answers on.
DJANGO_ALLOWED_HOSTS=papernews.example.com

# Absolute path to the SQLite file. Keep it outside the repo checkout so deploys never touch data.
DJANGO_DB_PATH=/var/lib/papernews/db.sqlite3
